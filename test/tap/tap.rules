# Rules exercised by the suritap phase-1 checks (cmd/suritap-probe check).
drop http $EXTERNAL_NET any -> $HOME_NET any (msg:"TAP uri /etc/passwd"; flow:established,to_server; http.uri; content:"/etc/passwd"; classtype:web-application-attack; sid:9000001; rev:1;)
drop http $EXTERNAL_NET any -> $HOME_NET any (msg:"TAP request body marker"; flow:established,to_server; http.request_body; content:"EVIL-BODY-MARKER"; classtype:web-application-attack; sid:9000002; rev:1;)
reject http $EXTERNAL_NET any -> $HOME_NET any (msg:"TAP reject user-agent"; flow:established,to_server; http.user_agent; content:"reject-me"; classtype:web-application-attack; sid:9000003; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"TAP alert only"; flow:established,to_server; http.uri; content:"/alert-only"; classtype:policy-violation; sid:9000004; rev:1;)
drop pgsql $EXTERNAL_NET any -> $HOME_NET any (msg:"TAP pgsql COPY ... PROGRAM"; flow:established,to_server; pgsql.query; content:"COPY"; nocase; content:"PROGRAM"; nocase; distance:0; classtype:attempted-admin; sid:9000005; rev:1;)
drop http $HOME_NET any -> $EXTERNAL_NET any (msg:"TAP response body leak"; flow:established,to_client; http.response_body; content:"SECRET-LEAK"; classtype:policy-violation; sid:9000006; rev:1;)
drop tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"TAP raw stream marker"; flow:established,to_server; content:"RAW-STREAM-EVIL"; classtype:misc-attack; sid:9000007; rev:1;)
drop http2 $EXTERNAL_NET any -> $HOME_NET any (msg:"TAP http2 uri"; flow:established,to_server; http.uri; content:"/h2-evil"; classtype:web-application-attack; sid:9000008; rev:1;)
