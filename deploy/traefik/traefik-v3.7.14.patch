new file mode 100644
index 0000000..3499fa8
--- /dev/null
+++ b/pkg/server/suritap.go
@@ -0,0 +1,30 @@
+package server
+
+import (
+	"log/slog"
+
+	suritaptraefik "github.com/jc-lab/suricontroller/adapters/traefik"
+	"github.com/rs/zerolog"
+	"github.com/rs/zerolog/log"
+)
+
+// Route the suritap adapter logs into Traefik's logger.
+func init() {
+	suritaptraefik.Logger = slog.New(suritaptraefik.FuncHandler(func(level slog.Level, msg string, attrs []slog.Attr) {
+		var ev *zerolog.Event
+		switch {
+		case level >= slog.LevelError:
+			ev = log.Error()
+		case level >= slog.LevelWarn:
+			ev = log.Warn()
+		case level >= slog.LevelInfo:
+			ev = log.Info()
+		default:
+			ev = log.Debug()
+		}
+		for _, a := range attrs {
+			ev = ev.Interface(a.Key, a.Value.Any())
+		}
+		ev.Msg(msg)
+	}))
+}
